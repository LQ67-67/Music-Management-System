<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.example.musiclibrary.controller.MusicPlayerController"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/app.css"
            prefWidth="600.0"
            prefHeight="500.0">

    <top>
        <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <children>
                <Label text="Music Player" styleClass="title-label"/>
                <Label fx:id="nowPlayingLabel" text="Select a track to play"
                       style="-fx-text-fill: #0066cc; -fx-font-size: 12px;"/>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <ImageView fx:id="trackImageView" fitWidth="180" fitHeight="180" preserveRatio="true"/>
                <Label text="Playlist:" style="-fx-font-weight: bold;"/>
                <ListView fx:id="playlistView" prefHeight="300" VBox.vgrow="ALWAYS"/>

                <HBox spacing="10">
                    <padding>
                        <Insets top="5"/>
                    </padding>
                    <children>
                        <Label text="Progress:"/>
                        <Slider fx:id="progressSlider" min="0" max="100" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="timeLabel" text="00:00 / 00:00" prefWidth="80"/>
                    </children>
                </HBox>

                <HBox spacing="10">
                    <children>
                        <Label text="Volume:"/>
                        <Slider fx:id="volumeSlider" min="0" max="100" prefWidth="150"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <children>
                <Button fx:id="playButton" text="▶ Play" onAction="#handlePlay" prefWidth="80"/>
                <Button fx:id="pauseButton" text="⏸ Pause" onAction="#handlePause" prefWidth="80"/>
                <Button fx:id="stopButton" text="⏹ Stop" onAction="#handleStop" prefWidth="80"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
