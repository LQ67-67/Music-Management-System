<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.example.musiclibrary.controller.MusicPlayerController"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/app.css"
            prefWidth="1200.0"
            prefHeight="800.0">

    <top>
        <VBox spacing="10" styleClass="header-bar">
            <padding>
                <Insets top="14" right="15" bottom="14" left="15"/>
            </padding>
            <children>
                <Label text="MUSIC PLAYER" styleClass="title-label header-title"/>
                <Label fx:id="nowPlayingLabel" text="Select a track to play"
                       style="-fx-text-fill: #8A8A8A; -fx-font-size: 11px;"/>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-faint-focus-color: transparent; -fx-focus-color: transparent;">
            <VBox spacing="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <children>
                    <ImageView fx:id="trackImageView" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                    <Label text="PLAYLIST:" styleClass="small"/>
                    <ListView fx:id="playlistView" VBox.vgrow="ALWAYS" maxHeight="Infinity" prefHeight="300"/>

                    <HBox spacing="10">
                        <padding>
                            <Insets top="5"/>
                        </padding>
                        <children>
                            <Label text="Progress:"/>
                            <Slider fx:id="progressSlider" min="0" max="100" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="timeLabel" text="00:00 / 00:00" prefWidth="80"/>
                        </children>
                    </HBox>

                    <HBox spacing="10">
                        <children>
                            <Label text="Volume:"/>
                            <Slider fx:id="volumeSlider" min="0" max="100" prefWidth="150"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-border-color: #262626; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <children>
                <Button fx:id="previousButton" text="⏮ PREVIOUS" onAction="#handlePrevious" prefWidth="150"/>
                <Button fx:id="playButton" text="▶ PLAY" onAction="#handlePlay" prefWidth="120"/>
                <Button fx:id="pauseButton" text="⏸ PAUSE" onAction="#handlePause" prefWidth="120"/>
                <Button fx:id="nextButton" text="⏭ NEXT" onAction="#handleNext" prefWidth="120"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>