<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.musiclibrary.controller.OrderManagementController"
            stylesheets="@../css/app.css"
            prefWidth="1500.0"
            prefHeight="1000.0">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Label text="My Orders" styleClass="title-label"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <TableView fx:id="orderTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="80"/>
                        <TableColumn fx:id="colOrderDate" text="Date" prefWidth="140"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
                    </columns>
                </TableView>

                <TableView fx:id="orderItemTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="colTrack" text="Track" prefWidth="200"/>
                        <TableColumn fx:id="colQuantity" text="Qty" prefWidth="60"/>
                        <TableColumn fx:id="colUnitPrice" text="Unit Price" prefWidth="100"/>
                        <TableColumn fx:id="colLineTotal" text="Line Total" prefWidth="100"/>
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <children>
                        <Label text="Shipping City:"/>
                        <TextField fx:id="shippingCityField" prefWidth="150"/>
                        <Button text="Confirm Order" onAction="#handleConfirmOrder"/>
                        <Button text="Cancel Order" onAction="#handleCancelOrder"/>
                        <Button text="Delete Order" onAction="#handleDeleteOrder"/>
                        <Button text="View Invoice" onAction="#handleViewInvoice"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>

