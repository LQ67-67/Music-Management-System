<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.musiclibrary.controller.AdminMainController"
            stylesheets="@../css/app.css"
            prefWidth="1280.0"
            prefHeight="864.0">

    <top>
        <HBox spacing="10" styleClass="header-bar">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Label text="ADMIN CONTROL PANEL" styleClass="title-label header-title"/>
                <Label fx:id="welcomeLabel" styleClass="header-welcome"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="LOGOUT →" onAction="#handleLogout" styleClass="neo-button-danger"/>
            </children>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane">
            <tabs>
                <Tab fx:id="tracksTab" text="01 · TRACKS" closable="false"/>
                <Tab fx:id="customersTab" text="02 · CUSTOMERS" closable="false"/>
                <Tab fx:id="ordersTab" text="03 · ORDERS" closable="false"/>
                <Tab fx:id="reportsTab" text="04 · REPORTS" closable="false"/>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
